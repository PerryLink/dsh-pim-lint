{
  "name": "@perrylink/dsh-pim-lint",
  "version": "0.1.0-alpha.0",
  "description": "Public/synthetic PIM catalog lint: required fields, duplicate SKU, GTIN check digit, price validation. Not a channel listing or PIM product.",
  "type": "module",
  "main": "./lib/plugin/index.js",
  "types": "./lib/plugin/index.d.ts",
  "exports": { ".": { "types": "./lib/plugin/index.d.ts", "default": "./lib/plugin/index.js" } },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE", "NOTICE"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "engines": { "dsh": ">=0.2.1-rc.3 <0.3.0", "node": ">=24.9.0 <25" },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "prepublishOnly": "node scripts/check-npm-name.mjs"
  },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "pim", "gtin", "perrylink"],
  "repository": { "type": "git", "url": "git+https://github.com/PerryLink/dsh-pim-lint.git" },
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  }
}
